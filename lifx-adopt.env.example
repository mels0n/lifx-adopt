# Credentials for lifx-adopt. Install as /etc/lifx-adopt/lifx-adopt.env,
# owned by root, mode 0600. The script refuses to run if the file is readable
# by anyone else.
#
# This file is sourced by bash, so single-quote values that contain spaces,
# $, !, or other shell characters.

# The WiFi network your bulbs should join (2.4 GHz; LIFX bulbs have no 5 GHz radio).
LIFX_SSID='YourNetworkName'
LIFX_PSK='your-wifi-passphrase'

# Optional. Security protocol sent to the bulb; default 5 (WPA2 AES PSK).
# 1=OPEN 2=WEP_PSK 3=WPA_TKIP_PSK 4=WPA_AES_PSK
# 5=WPA2_AES_PSK 6=WPA2_TKIP_PSK 7=WPA2_MIXED_PSK
#LIFX_SECURITY=5
